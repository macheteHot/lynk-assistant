<?xml version="1.0" encoding="utf-8"?>
<!--
  关于 applicationId：为什么是 com.geely.lynkassistant
  ==========================================================================
  车机桌面（OneOS-Launcher3）的小组件过滤 BaseWidgetVm.isNeedWidget() 里有一条
  兜底分支：
        (displayType == 0) && packageName.startsWith("com.geely")
  即「主屏组件只要包名以 com.geely 开头即通过」。实测：
    - com.geely.lynkcard（普通类名）        -> 桌面「添加卡片」列表可见
    - io.github.machetehot.lynkassistant（同类名）-> 不可见
  所以 applicationId 定为 com.geely.lynkassistant；Java 包名同名。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.geely.lynkassistant"
    android:versionCode="2"
    android:versionName="1.1">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="31" />

    <!-- enumerate every installed app -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
      The Geely/OneOS app-store provider permission is protectionLevel=normal
      (verified in OneOS-AppStore.apk), so declaring it is enough to be
      granted. This is what allows registering ANY package into the launcher's
      "My Apps" list.
    -->
    <uses-permission android:name="com.geely.appstore.APPSTORE_PROVIDER" />

    <!--
      Installing: the APK is handed to the system package installer, which needs
      the requesting app to be allowed in "install unknown apps"
      (REQUEST_INSTALL_PACKAGES is signature|appop on this head unit).
      Uninstalling: REQUEST_DELETE_PACKAGES is normal; ACTION_DELETE shows the
      system confirmation UI, so no privileged permission is involved.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <queries>
        <package android:name="com.desaysv.engmode" />
        <package android:name="com.desaysv.engmode.custom" />
        <package android:name="com.desaysv.vehicle.carplayapp" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppListActivity"
            android:exported="false"
            android:label="@string/app_list_title" />

        <activity
            android:name=".DeviceInfoActivity"
            android:exported="false"
            android:label="@string/device_info_title" />

        <activity
            android:name=".ApkInstallActivity"
            android:exported="false"
            android:label="@string/install_title" />

        <activity
            android:name=".AppManagerActivity"
            android:exported="false"
            android:label="@string/app_manager_title" />

        <!-- serves the copied APK to the system installer as content:// -->
        <provider
            android:name=".ApkFileProvider"
            android:authorities="com.geely.lynkassistant.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
